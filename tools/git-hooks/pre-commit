#!/bin/sh
#
# Keeps the footer "Last updated" date in step with what is actually shipping.
# Silent and automatic: on a commit that touches site content, it restamps every
# page to today and stages the result. Nothing to remember, nothing printed
# unless it declines to act.
#
# Enable once per clone (core.hooksPath is local config, not committed):
#
#     git config core.hooksPath tools/git-hooks
#
# Bypass for a single commit with `git commit --no-verify`.

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# 1. Only act when the commit actually changes something a visitor sees. A
#    commit touching only tools/, .claude/ or docs should not drag eight
#    restamped pages along with it.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -qE '(^|/)[^/]+\.(html|css|js|json)$|^SV_CV\.pdf$'; then
    exit 0
fi

# 2. Refuse to touch the pages if any of them has unstaged edits. Stamping would
#    mean `git add`-ing those files wholesale, which would sweep work-in-progress
#    into a commit the author never intended it to be in. Losing the date stamp
#    is recoverable; silently committing someone's half-finished edit is not.
if ! git diff --quiet -- '*.html'; then
    echo "pre-commit: unstaged HTML changes present, skipping footer restamp" >&2
    echo "            stage them (or run tools/stamp_updated.py yourself) to include it" >&2
    exit 0
fi

# 3. Stamp, then stage only the pages the stamp actually changed.
if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, skipping footer restamp" >&2
    exit 0
fi

python3 tools/stamp_updated.py >/dev/null 2>&1 || {
    echo "pre-commit: stamp_updated.py failed, committing without a restamp" >&2
    exit 0
}

changed=$(git diff --name-only -- '*.html')
if [ -n "$changed" ]; then
    printf '%s\n' "$changed" | xargs git add --
fi

exit 0
